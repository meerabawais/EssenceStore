# Root .env.example — used only by the gateway. mystore and essence-admin
# each read their own .env file from within their own directory (standard
# Next.js behavior); copy mystore/.env.example and essence-admin/.env.example
# to .env in each of those folders as well.

# Port the gateway listens on. This is the single public entry point.
GATEWAY_PORT=3000

# Internal origins the gateway proxies to. Only change these if you also
# change the -p flags in mystore/package.json and essence-admin/package.json.
STORE_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002
